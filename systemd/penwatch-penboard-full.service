[Unit]
Description=PenWatch Penboard Full Scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=penwatch
Group=penwatch
WorkingDirectory=/opt/penwatch
EnvironmentFile=/opt/penwatch/.env
ExecStart=/usr/bin/flock -w 7200 /tmp/penwatch-penboard.lock /opt/penwatch/venv/bin/python /opt/penwatch/src/run_penboard.py --full-scan

[Install]
WantedBy=multi-user.target
