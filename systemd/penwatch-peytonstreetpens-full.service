[Unit]
Description=PenWatch Peyton Street Pens Full Scan
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=penwatch
Group=penwatch
WorkingDirectory=/opt/penwatch
EnvironmentFile=/opt/penwatch/.env
ExecStart=/usr/bin/flock -w 1800 /tmp/penwatch-peytonstreetpens.lock /opt/penwatch/venv/bin/python /opt/penwatch/src/run_peytonstreetpens.py --full-scan
